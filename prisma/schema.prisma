// prisma/schema.prisma
// Jalankan: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null jika login via Google
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  uploads       Media[]         @relation("UploadedBy")
  playlists     Playlist[]
  subscriptions Subscription[]
  payments      Payment[]
  royalties     Royalty[]       @relation("ArtistRoyalties")
}

enum Role {
  USER
  CREATOR
  ADMIN
}

// ─────────────────────────────────────────
// AUTH.JS REQUIRED TABLES
// ─────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────
// MEDIA (MUSIK & VIDEO)
// ─────────────────────────────────────────
model Media {
  id             String      @id @default(cuid())
  title          String
  description    String?
  type           MediaType   // MUSIC | VIDEO
  mediaUrl       String      // URL S3
  thumbnailUrl   String?
  duration       Int?        // detik
  category       String?
  genre          String?
  status         MediaStatus @default(PENDING)
  playCount      Int         @default(0)
  uploadedById   String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  uploadedBy     User        @relation("UploadedBy", fields: [uploadedById], references: [id])
  playlistItems  PlaylistItem[]
  royalties      Royalty[]
}

enum MediaType {
  MUSIC
  VIDEO
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// PLAYLIST
// ─────────────────────────────────────────
model Playlist {
  id          String         @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  isPublic    Boolean        @default(true)
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id])
  items       PlaylistItem[]
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  mediaId    String
  order      Int
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([playlistId, mediaId])
}

// ─────────────────────────────────────────
// SUBSCRIPTION (untuk akses premium)
// ─────────────────────────────────────────
model Subscription {
  id               String             @id @default(cuid())
  userId           String
  stripeSubId      String?            @unique
  plan             SubscriptionPlan
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id])
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  CREATOR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

// ─────────────────────────────────────────
// PAYMENT & HAK CIPTA (ROYALTY)
// ─────────────────────────────────────────
model Payment {
  id              String        @id @default(cuid())
  userId          String
  stripePaymentId String?       @unique
  amount          Int           // dalam cent (IDR atau USD)
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  description     String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Royalty transparan: siapa artist, berapa stream, berapa bayaran
model Royalty {
  id         String   @id @default(cuid())
  artistId   String
  mediaId    String
  period     String   // e.g. "2026-06"
  streams    Int      @default(0)
  amountUsd  Float    @default(0)
  paid       Boolean  @default(false)
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  artist     User     @relation("ArtistRoyalties", fields: [artistId], references: [id])
  media      Media    @relation(fields: [mediaId], references: [id])

  @@unique([artistId, mediaId, period])
}
